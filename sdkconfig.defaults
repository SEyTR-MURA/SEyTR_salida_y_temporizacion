# Valores de partida del proyecto. Este fichero se escribe a mano y se versiona;
# sdkconfig lo genera la herramienta y no se versiona.

# Sin esto, el destino de compilacion por omision no es el de la asignatura.
CONFIG_IDF_TARGET="esp32s3"

# Frecuencia del tic del planificador. Con el valor por omision, 100 Hz, el tic
# dura 10 ms y un trabajo de 2 ms dentro del bucle no llega a un tic: con el,
# la espera relativa no deriva y las dos formas de esperar salen iguales.
# A 1000 Hz el tic dura 1 ms. Es la frecuencia de todos los proyectos de la
# asignatura.
CONFIG_FREERTOS_HZ=1000
